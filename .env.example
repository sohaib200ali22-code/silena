DISCORD_TOKEN=replace-with-bot-token
CLIENT_ID=replace-with-application-id
GUILD_ID=replace-with-server-id
OWNER_ID=replace-with-your-discord-user-id
STAFF_ROLE_ID=replace-with-staff-role-id
TICKETS_CHANNEL_ID=replace-with-ticket-archive-channel-id

# Invite links are blocked by default; ordinary links are allowed.
BLOCK_INVITES=true
BLOCK_LINKS=false
SPAM_MAX_MESSAGES=5
SPAM_WINDOW_SECONDS=8
